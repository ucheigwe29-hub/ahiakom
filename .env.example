# Local persistent PostgreSQL engine. Switch to postgres for deployment.
DATABASE_DRIVER=pglite
DATABASE_PATH=.data/ahiakom
# DATABASE_URL=postgresql://user:password@localhost:5432/ahiakom
APP_ORIGIN=http://localhost:3000
PAYMENT_MODE=simulated
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_WEBHOOK_SECRET=whsec_...
# Demo checkout MUST be disabled for production.
ENABLE_DEMO_PAYMENTS=true
